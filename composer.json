{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "akaunting/laravel-firewall": "^1.3",
        "algolia/scout-extended": "^1.20",
        "backpack/backupmanager": "^3.0",
        "backpack/crud": "4.1.*",
        "backpack/logmanager": "^4.0",
        "backpack/pagemanager": "^3.0",
        "backpack/permissionmanager": "^6.0",
        "doctrine/dbal": "^2.10",
        "fabpot/goutte": "^4.0",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "intervention/image": "^2.5",
        "laravel/framework": "^8.0",
        "laravel/horizon": "^5.10",
        "laravel/passport": "^10.4",
        "laravel/slack-notification-channel": "^2.2",
        "laravel/socialite": "^5.0",
        "laravel/tinker": "^2.0",
        "laravel/ui": "^3.0",
        "league/csv": "^9.8",
        "opencage/geocode": "^3.0",
        "sentry/sentry-laravel": "^2.0",
        "simplepie/simplepie": "^1.5",
        "spatie/laravel-activitylog": "^3.14",
        "spatie/laravel-honeypot": "3.0.1",
        "spatie/laravel-json-api-paginate": "^1.7",
        "spatie/laravel-permission": "^3.13",
        "spatie/laravel-query-builder": "^3.0",
        "stevebauman/purify": "^4.0",
        "te7a-houdini/laravel-trix": "^2.0",
        "yadahan/laravel-authentication-log": "^1.2"
    },
    "require-dev": {
        "backpack/generators": "^3.1",
        "barryvdh/laravel-debugbar": "^3.5",
        "facade/ignition": "^2.3.6",
        "friendsofphp/php-cs-fixer": "^2.16",
        "fzaninotto/faker": "^1.9.1",
        "laracasts/generators": "^1.1",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^5.0",
        "phpunit/phpunit": "^9.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
