{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "akaunting/laravel-firewall": "^1.3",
        "algolia/scout-extended": "^2.0",
        "backpack/backupmanager": "^4.0",
        "backpack/crud": "^5.0",
        "backpack/logmanager": "^4.0",
        "backpack/pagemanager": "^3.0",
        "backpack/permissionmanager": "^6.0",
        "backpack/pro": "*",
        "biscolab/laravel-recaptcha": "^6.0",
        "doctrine/dbal": "^2.13",
        "fabpot/goutte": "^4.0",
        "guzzlehttp/guzzle": "^7.2",
        "intervention/image": "^2.5",
        "laravel/framework": "^9.52",
        "laravel/horizon": "^5.10",
        "laravel/passport": "^10.4",
        "laravel/slack-notification-channel": "^2.5",
        "laravel/socialite": "^5.3",
        "laravel/tinker": "^2.7",
        "laravel/ui": "^3.3",
        "league/csv": "^9.8",
        "league/flysystem-aws-s3-v3": "^3.0",
        "opencage/geocode": "^3.0",
        "sentry/sentry-laravel": "^2.11",
        "simplepie/simplepie": "^1.5",
        "spatie/laravel-activitylog": "^4.4",
        "spatie/laravel-honeypot": "^4.1",
        "spatie/laravel-json-api-paginate": "^1.11",
        "spatie/laravel-permission": "^5.5",
        "spatie/laravel-query-builder": "^5.0",
        "stevebauman/purify": "^4.0",
        "te7a-houdini/laravel-trix": "^2.0",
        "yadahan/laravel-authentication-log": "^1.5"
    },
    "require-dev": {
        "backpack/generators": "^3.3",
        "barryvdh/laravel-debugbar": "^3.6",
        "laracasts/generators": "^2.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^6.3",
        "phpunit/phpunit": "^9.5.10",
        "fakerphp/faker": "^1.9.1",
        "spatie/laravel-ignition": "^1.4"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://repo.backpackforlaravel.com/"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ]
    }
}
